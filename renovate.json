{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "dependencyDashboard": true,
  "dockerfile": {
    "managerFilePatterns": [
      "/(^|/)Containerfile$/",
      "/(^|/)Dockerfile$/"
    ]
  },
  "mise": {
    "managerFilePatterns": [
      "/(^|/)mise\\.toml$/",
      "/(^|/)\\.mise\\.toml$/"
    ]
  },
  "packageRules": [
    {
      "matchDepNames": [
        "ruby",
        "docker.io/library/ruby"
      ],
      "groupName": "Ruby version"
    }
  ]
}
