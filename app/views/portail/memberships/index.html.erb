<% content_for :title, t(".title") %>

<h1><%= t(".heading") %></h1>
<p class="fr-text--lead"><%= t(".lead") %></p>

<%# Emboîtement DSFR qui porte le défilement horizontal. Pas d'état vide : l'administrateur
    figure lui-même dans la liste. Pas de pagination : à revoir si l'import (#983) révèle de
    grosses organisations. La caption, exigée par le RGAA, est masquée : le h1 porte déjà le titre. %>
<div class="fr-table fr-table--bordered fr-table--no-caption">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption><%= t(".caption") %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t(".fields.agent") %></th>
              <th scope="col"><%= t(".fields.email") %></th>
              <th scope="col"><%= t(".fields.job_title") %></th>
              <th scope="col"><%= t(".fields.phone_number") %></th>
              <th scope="col"><%= t(".fields.role") %></th>
              <th scope="col" class="membership-data-streams-column"><%= t(".fields.data_streams") %></th>
              <th scope="col"><%= t(".fields.last_signed_in_at") %></th>
            </tr>
          </thead>
          <tbody>
            <% @memberships.each do |membership| %>
              <tr>
                <td><%= membership_agent_name(membership) %></td>
                <td><%= membership_email(membership) %></td>
                <td><%= membership_job_title(membership) %></td>
                <td><%= membership_phone_number(membership) %></td>
                <td><%= membership_role(membership) %></td>
                <td><%= membership_data_streams(membership, names: @data_stream_names, subscribed_codes: @subscribed_data_stream_codes) %></td>
                <td><%= membership_last_signed_in_at(membership) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
