<%# locals: (delivery_path:, subject:) %>
<% content_for :title, t(".#{subject}.title") %>

<div class="fr-grid-row fr-grid-row--center">
  <div class="fr-col-12 fr-col-md-8">
    <h1><%= t(".#{subject}.heading") %></h1>
    <p class="fr-text--lead"><%= t(".lead") %></p>

    <ul class="fr-btns-group fr-btns-group--inline-md">
      <li><%= link_to t(".back_to_delivery"), delivery_path, class: "fr-btn" %></li>
      <li><%= link_to t("portail.errors.back_home"), root_path, class: "fr-btn fr-btn--secondary" %></li>
    </ul>
  </div>
</div>
