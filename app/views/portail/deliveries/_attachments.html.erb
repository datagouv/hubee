<%# locals: (attachments:, caption:, delivery: nil) %>
<%# Un inventaire, dont seules les pièces reçues d'un dépôt se téléchargent : `delivery` n'est
    donné que pour le dépôt, les pièces d'un événement n'ayant pas d'adresse. La caption, exigée
    par le RGAA, est masquée : la section qui appelle porte déjà le titre. %>
<div class="fr-table fr-table--bordered fr-table--no-caption">
  <div class="fr-table__wrapper">
    <div class="fr-table__container">
      <div class="fr-table__content">
        <table>
          <caption><%= caption %></caption>
          <thead>
            <tr>
              <th scope="col"><%= t("portail.deliveries.attachment_fields.filename") %></th>
              <th scope="col"><%= t("portail.deliveries.attachment_fields.kind") %></th>
              <th scope="col"><%= t("portail.deliveries.attachment_fields.byte_size") %></th>
              <th scope="col"><%= t("portail.deliveries.attachment_fields.state") %></th>
              <% if delivery %>
                <th scope="col"><%= t("portail.deliveries.attachment_fields.download") %></th>
              <% end %>
            </tr>
          </thead>
          <tbody>
            <% attachments.each do |attachment| %>
              <tr>
                <td><%= attachment.filename %></td>
                <td><%= attachment.kind %></td>
                <td><%= delivery_attachment_size(attachment) %></td>
                <td><%= delivery_attachment_state(attachment) %></td>
                <% if delivery %>
                  <td>
                    <% if attachment.state == "received" %>
                      <%# Hors de Turbo : c'est un fichier, pas une page, le navigateur le reçoit lui-même. %>
                      <%= link_to t("portail.deliveries.attachments.download"),
                            demarche_piece_path(delivery.id, attachment.id),
                            class: "fr-btn fr-btn--sm fr-btn--secondary fr-icon-download-line fr-btn--icon-left",
                            data: {turbo: false} %>
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
