<%# locals: (delivery:, label:, describedby: nil) %>
<%# Mêmes raisons que le lien d'une pièce : ni `download`, ni Turbo. Seul le libellé se coupe, dans
    son `span` : le format reste avec l'icône (application.css). %>
<%= link_to safe_join([tag.span(label), " ", t("portail.deliveries.archives.download.format")]),
      teledossier_archive_path(delivery.id), class: "fr-link fr-link--download delivery-archive-link",
      aria: {describedby:}, data: {turbo: false} %>
