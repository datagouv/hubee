<%# locals: (delivery:, states:) %>
<div class="fr-callout fr-icon-information-line fr-mb-4w">
  <h2 class="fr-callout__title"><%= t(".title") %></h2>
  <p class="fr-callout__text">
    <%= t(".text", count: states.size, states: states.map { |state| t(".quoted_state", state: delivery_state_label(state)) }.to_sentence) %>
  </p>
  <p class="fr-callout__text"><%= t(".reload") %></p>

  <%= render "portail/deliveries/archive_link", delivery:, label: delivery_archive_label(delivery) %>
</div>
