<%# locals: (delivery:, label:, complete:) %>
<%# Rendu dans la grille du titre de la section : le lien et son aide en colonne à droite. Le
    quart d'unité centre le libellé sur la ligne du titre. %>
<div class="fr-col-12 fr-mt-1v delivery-attachments__archive">
  <%= render "portail/deliveries/archive_link", delivery:, label:,
        describedby: ("delivery-archive-hint" unless complete) %>
  <%# À la place du détail DSFR, mais hors du lien : il ne fait pas partie de son nom. %>
  <% unless complete %>
    <p id="delivery-archive-hint" class="fr-hint-text fr-mt-1v fr-mb-0"><%= t("portail.deliveries.archives.hint") %></p>
  <% end %>
</div>
