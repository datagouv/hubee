<% content_for :title, t(".title") %>

<h1><%= t(".heading", number: @delivery.number) %></h1>

<dl class="fr-mb-4w">
  <dt><%= t("portail.deliveries.index.columns.state") %></dt>
  <dd><%= t("portail.deliveries.states.#{@delivery.state}") %></dd>

  <dt><%= t("portail.deliveries.index.columns.data_stream") %></dt>
  <dd><%= @delivery.data_stream.code %></dd>

  <dt><%= t("portail.deliveries.index.columns.transmitted_at") %></dt>
  <dd><%= @delivery.transmitted_at ? l(@delivery.transmitted_at, format: :short) : "—" %></dd>

  <dt><%= t("portail.deliveries.index.columns.updated_at") %></dt>
  <dd><%= @delivery.updated_at ? l(@delivery.updated_at, format: :short) : "—" %></dd>

  <%# Le demandeur est absent de la liste servie en amont, mais présent au détail. %>
  <% if @delivery.data_package&.applicant %>
    <dt><%= t(".applicant") %></dt>
    <dd><%= [@delivery.data_package.applicant.first_name, @delivery.data_package.applicant.last_name].compact.join(" ") %></dd>
  <% end %>
</dl>

<%= link_to t(".back"), demarches_path, class: "fr-link fr-icon-arrow-left-line fr-link--icon-left" %>
