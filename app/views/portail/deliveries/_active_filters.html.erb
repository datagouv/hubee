<%# locals: (criteria:) %>
<%# Les filtres posés, rappelés au-dessus des résultats en tags supprimables. Des liens et non
    des boutons : l'état vit dans l'URL, retirer un filtre est une navigation, sans JavaScript. %>
<% if criteria.filtered? %>
  <div class="delivery-active-filters fr-mb-2w">
    <ul class="fr-tags-group" aria-label="<%= t(".active") %>">
      <% if criteria.number %>
        <li>
          <%= link_to t(".number", number: criteria.number), demarches_path(**criteria.with(number: nil).link_params),
                class: "fr-tag fr-tag--dismiss", "aria-label": t(".remove", filter: t(".number", number: criteria.number)) %>
        </li>
      <% end %>
      <% criteria.data_stream_codes.each do |code| %>
        <li>
          <%= link_to code, demarches_path(**criteria.with(data_stream_codes: criteria.data_stream_codes - [code]).link_params),
                class: "fr-tag fr-tag--dismiss", "aria-label": t(".remove", filter: code) %>
        </li>
      <% end %>
      <% if criteria.transmitted_from || criteria.transmitted_to %>
        <li>
          <%= link_to delivery_period_label(criteria), demarches_path(**criteria.with(transmitted_from: nil, transmitted_to: nil).link_params),
                class: "fr-tag fr-tag--dismiss", "aria-label": t(".remove", filter: delivery_period_label(criteria)) %>
        </li>
      <% end %>
    </ul>
    <%# Hors du groupe de tags : ce n'est pas un filtre, c'est l'action qui les lève tous. Le tri
        reste, comme dans les tags unitaires. %>
    <%= link_to t(".clear_all"),
          demarches_path(**criteria.with(data_stream_codes: [], number: nil, transmitted_from: nil, transmitted_to: nil).link_params),
          class: "fr-link fr-icon-delete-line fr-link--icon-left" %>
  </div>
<% end %>
