<%= render "heading" %>

<%# Refus ou panne : rien à lister ni à compter, la page ne dit que la conséquence. %>
<% if @failure %>
  <p class="fr-text--lead"><%= t(".failures.#{@failure}") %></p>
<% else %>
<div class="fr-grid-row fr-grid-row--gutters">
  <div class="fr-col-12 fr-col-md-4 fr-col-lg-3">
    <%= render "state_menu", counts_by_state: @page.counts_by_state, current_state: @current_state %>
  </div>

  <div class="fr-col-12 fr-col-md-8 fr-col-lg-9">
    <%# Le message vide reste à côté du menu : le compteur d'un autre état dit où aller. %>
    <% if @deliveries.empty? %>
      <p class="fr-text--lead"><%= t(".empty") %></p>
    <% else %>
      <%# Le total est celui de l'amont, compté avant la policy : une page servie hors périmètre
          montre moins de lignes qu'annoncé. L'écart est alerté, pas masqué. %>
      <p class="fr-text--sm fr-text-mention--grey">
        <%= t(".total", count: @page.pagination.total) %>
      </p>

      <%# Emboîtement DSFR qui porte le défilement horizontal. Pas de colonne « État » :
          l'amont ne sert qu'un état à la fois. %>
      <div class="fr-table fr-table--bordered">
        <div class="fr-table__wrapper">
          <div class="fr-table__container">
            <div class="fr-table__content">
              <table>
                <caption><%= t(".caption", state: delivery_state_label(@current_state)) %></caption>
                <thead>
                  <tr>
                    <th scope="col"><%= t("portail.deliveries.fields.number") %></th>
                    <th scope="col"><%= t("portail.deliveries.fields.data_stream") %></th>
                    <th scope="col"><%= t("portail.deliveries.fields.transmitted_at") %></th>
                    <th scope="col"><%= t("portail.deliveries.fields.updated_at") %></th>
                  </tr>
                </thead>
                <tbody>
                  <% @deliveries.each do |delivery| %>
                    <tr>
                      <td><%= link_to delivery.number, demarche_path(delivery.id) %></td>
                      <td><%= delivery.data_stream.code %></td>
                      <td><%= delivery_transmitted_at(delivery) %></td>
                      <td><%= delivery_updated_at(delivery) %></td>
                    </tr>
                  <% end %>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </div>

      <%= render "pagination", pagination: @page.pagination, state: @current_state %>
    <% end %>
  </div>
</div>
<% end %>
