<%# locals: (delivery:, state:) %>
<div class="fr-callout fr-icon-information-line fr-mb-4w">
  <h2 class="fr-callout__title"><%= t(".#{state}.title") %></h2>
  <p class="fr-callout__text"><%= t(".#{state}.text") %></p>

  <%= form_with url: teledossier_etat_path(delivery.id), method: :patch do |form| %>
    <%= hidden_field_tag :etat, state, id: nil %>
    <%= form.dsfr_submit t(".#{state}.submit") %>
  <% end %>
</div>
