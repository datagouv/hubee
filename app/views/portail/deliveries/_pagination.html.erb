<%# locals: (pagination:, state:) %>
<% if pagination.total_pages > 1 %>
  <nav class="fr-pagination fr-mt-4w" role="navigation" aria-label="<%= t("portail.deliveries.pagination.label") %>">
    <ul class="fr-pagination__list">
      <li>
        <%= delivery_pagination_step t("portail.deliveries.pagination.previous"), "prev",
              href: (demarches_path(statut: state, page: pagination.current_page - 1) if pagination.current_page > 1) %>
      </li>
      <% delivery_pagination_pages(pagination).each do |page| %>
        <li>
          <% if page == :gap %>
            <%# Pas de classe DSFR ici : l'ellipse n'est pas un lien, et emprunter
                fr-pagination__link pour un élément inerte sortirait du système. %>
            <span aria-hidden="true">…</span>
          <% else %>
            <%= delivery_pagination_page page,
                  href: (demarches_path(statut: state, page: page) unless page == pagination.current_page) %>
          <% end %>
        </li>
      <% end %>
      <li>
        <%= delivery_pagination_step t("portail.deliveries.pagination.next"), "next",
              href: (demarches_path(statut: state, page: pagination.current_page + 1) if pagination.current_page < pagination.total_pages) %>
      </li>
    </ul>
  </nav>
<% end %>
