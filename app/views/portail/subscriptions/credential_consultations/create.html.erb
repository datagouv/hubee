<%# locals: (subscription:, credentials:, failure:) -%>
<%# La réponse du POST, affichée par le navigateur (le bouton part hors Turbo). Le seul endroit où le
    secret quitte son enveloppe (`reveal`), pour être confié à la copie. Le portail entier est servi
    sous `no-store`, mais Turbo garde aussi, dans la page, une copie de chaque page qu'il quitte, et la
    réaffiche au retour arrière sans rien demander : celle-ci en est exclue. %>
<% content_for :head, tag.meta(name: "turbo-cache-control", content: "no-cache") %>
<% content_for :title, t(".title", data_stream: subscription.data_stream_display_name) %>

<%# Le fil d'Ariane de l'abonnement, prolongé : la page en est une suite, et le lien de retour en vient. %>
<nav role="navigation" class="fr-breadcrumb" aria-label="<%= t("portail.subscriptions.show.breadcrumb") %>">
  <button class="fr-breadcrumb__button" aria-expanded="false" aria-controls="credentials-breadcrumb">
    <%= t("portail.subscriptions.show.breadcrumb_open") %>
  </button>
  <div class="fr-collapse" id="credentials-breadcrumb">
    <ol class="fr-breadcrumb__list">
      <li><%= link_to t("portail.subscriptions.show.home"), root_path, class: "fr-breadcrumb__link" %></li>
      <li><%= link_to t("portail.subscriptions.index.heading"), abonnements_path, class: "fr-breadcrumb__link" %></li>
      <li><%= link_to subscription.data_stream_display_name, abonnement_path(subscription.id), class: "fr-breadcrumb__link" %></li>
      <%# Sans href : le DSFR marque l'étape courante par `aria-current`. %>
      <li><a class="fr-breadcrumb__link" aria-current="page"><%= t("portail.subscriptions.credentials.heading") %></a></li>
    </ol>
  </div>
</nav>

<div id="subscription-credentials">
  <h1><%= t("portail.subscriptions.credentials.heading") %></h1>
  <p class="fr-text--lead fr-mb-4w"><%= subscription.data_stream_display_name %></p>

  <div class="fr-grid-row fr-grid-row--gutters">
    <div class="fr-col-12 fr-col-md-8">
      <section class="fr-p-3w fr-border-default--grey" aria-labelledby="credentials-list-heading">
        <h2 id="credentials-list-heading" class="fr-sr-only"><%= t(".list_heading") %></h2>
        <%# Un refus est durable, un cas pour l'équipe HubEE. Une panne peut durer : réessayer plus tard,
            puis écrire au support. %>
        <% if failure == :refused %>
          <div class="fr-alert fr-alert--warning fr-alert--sm">
            <p><%= t("portail.subscriptions.credentials.refused_html", email: mail_to(support_email)) %></p>
          </div>
        <% elsif failure %>
          <div class="fr-alert fr-alert--error fr-alert--sm">
            <p><%= t("portail.subscriptions.credentials.unavailable_html", email: mail_to(support_email)) %></p>
          </div>
        <% else %>
          <p class="fr-text--sm fr-text-mention--grey fr-mb-3w"><%= t("portail.subscriptions.credentials.masked") %></p>
          <%# La copie passe par le script : sans lui, les boutons ne font rien, et la page le dit. %>
          <noscript>
            <div class="fr-alert fr-alert--info fr-alert--sm fr-mb-3w">
              <p><%= t(".javascript_required") %></p>
            </div>
          </noscript>
          <%# Des données affichées, pas un formulaire : seuls les boutons de copie prennent le focus. %>
          <dl class="fr-m-0 fr-p-0">
            <%= render "portail/subscriptions/credential_consultations/copyable", key: "client-id",
                  label: t("portail.subscriptions.credentials.client_id"),
                  target: t("portail.subscriptions.credentials.copy_target_client_id"), value: credentials.client_id %>
            <%= render "portail/subscriptions/credential_consultations/copyable", key: "client-secret",
                  label: t("portail.subscriptions.credentials.client_secret"),
                  target: t("portail.subscriptions.credentials.copy_target_client_secret"), value: credentials.client_secret.reveal %>
          </dl>
        <% end %>
      </section>
    </div>
    <%# Ce que l'agent doit garder en tête en les copiant : une mise en avant DSFR, à côté. %>
    <div class="fr-col-12 fr-col-md-4">
      <div class="fr-callout">
        <p class="fr-callout__text fr-text--md"><%= t("portail.subscriptions.credentials.lead") %></p>
        <p class="fr-text--sm fr-mt-2w fr-mb-0"><%= t("portail.subscriptions.credentials.audited") %></p>
      </div>
    </div>
  </div>

  <p class="fr-mt-4w">
    <%= link_to t(".back"), abonnement_path(subscription.id),
          class: "fr-btn fr-btn--secondary fr-btn--icon-left fr-icon-arrow-left-line" %>
  </p>
</div>
