<%# locals: (subscription:, credentials: nil, refusal: nil) %>
<%# La cible du Turbo Stream de la consultation : la section entière est remplacée, d'où un seul
    identifiant porté par l'élément racine. %>
<section id="subscription-credentials" class="subscription-panel fr-p-3w fr-border-default--grey fr-mb-4w"
  aria-labelledby="subscription-credentials-title">
  <h2 id="subscription-credentials-title" class="fr-h6 fr-mb-2w">
    <span class="fr-icon-lock-line fr-mr-1w" aria-hidden="true"></span><%= t(".title") %>
  </h2>

  <% if !subscription.api_access? %>
    <p class="fr-mb-0"><%= t(".portal_mode") %></p>
  <% elsif refusal %>
    <%# Un message par motif métier ; les autres orientent vers le support, sans code technique.
        Le bouton qui avait le focus a disparu : le refus est annoncé et reçoit le focus. %>
    <div class="fr-alert fr-alert--info fr-alert--sm" role="status" tabindex="-1" autofocus>
      <p>
        <% if refusal.in?(%i[not_api_mode not_active]) %>
          <%= t(".refusals.#{refusal}") %>
        <% else %>
          <%= t(".refusals.contact_support_html", email: mail_to(support_email)) %>
        <% end %>
      </p>
    </div>
  <% else %>
    <% if credentials %>
      <%# Retiré de la copie de la page que Turbo garde pour le bouton « précédent » : le secret ne
          revient pas sans une nouvelle consultation, tracée. L'invite qui suit reste dans la copie. %>
      <div class="subscription-credentials__revealed" data-turbo-temporary>
        <div class="fr-alert fr-alert--warning fr-alert--sm fr-mb-3w" role="alert">
          <p><%= t(".warning") %></p>
        </div>
        <div class="fr-input-group">
          <label class="fr-label" for="subscription-client-id"><%= t(".client_id") %></label>
          <%# Le bouton qui avait le focus a disparu : il passe au premier identifiant. %>
          <input class="fr-input" id="subscription-client-id" type="text" value="<%= credentials.client_id %>"
            readonly spellcheck="false" autofocus>
        </div>
        <div class="fr-input-group fr-mb-0">
          <label class="fr-label" for="subscription-client-secret"><%= t(".client_secret") %></label>
          <input class="fr-input" id="subscription-client-secret" type="text" value="<%= credentials.client_secret %>"
            readonly spellcheck="false" autocomplete="off">
        </div>
      </div>
    <% end %>
    <div class="subscription-credentials__prompt">
      <p><%= t(".hint") %></p>
      <%= button_to t(".reveal"), abonnement_identifiants_path(subscription.id), class: "fr-btn fr-btn--secondary" %>
    </div>
  <% end %>
</section>
