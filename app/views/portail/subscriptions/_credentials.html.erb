<%# locals: (subscription:, unlocked:) -%>
<%# Ne fait que proposer, et seulement à un abonnement API : un abonnement portail n'a pas de
    client OAuth. Le secret n'est lu qu'au clic, en POST (la règle est sur la route). %>
<% if subscription.api_access? %>
  <%= render "portail/subscriptions/credentials_panel", subscription_id: subscription.id, unlocked: %>
<% end %>
