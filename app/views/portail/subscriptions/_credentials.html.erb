<%# locals: (subscription:, reauthentication:) -%>
<%# Ne fait que proposer, et seulement à un abonnement API actif : un abonnement portail n'a pas de
    client OAuth, un abonnement inactif n'en a pas l'usage. Le bloc dit où en est l'agent, d'après la
    preuve de réauthentification, sans rien ouvrir : les deux boutons postent la même consultation, dont
    le garde seul décide. `reauthentication` vient du contrôleur : débloquée ou non pour cet abonnement,
    et jusqu'à quand. Un affichage périmé (preuve expirée, ou déjà utilisée dans un autre onglet)
    renvoie donc vers ProConnect au clic : le texte le dit, déconnexion comprise. Hors Turbo : la réponse est une page à afficher, ou un autre domaine.
    L'ancre est la cible du retour de la réauthentification. %>
<% if subscription.credentials_available? %>
  <section id="identifiants" class="subscription-panel fr-p-3w fr-mb-4w fr-border-default--grey">
    <h2 class="fr-h6 fr-mb-2w">
      <span class="fr-icon-lock-line fr-mr-1w" aria-hidden="true"></span><%= t("portail.subscriptions.credentials.heading") %>
    </h2>
    <p class="fr-mb-2w"><%= t("portail.subscriptions.credentials.lead") %></p>
    <% if reauthentication.unlocked? %>
      <div class="fr-alert fr-alert--success fr-alert--sm fr-mb-3w">
        <p><%= t("portail.subscriptions.credentials.unlocked", time: l(reauthentication.unlocked_until, format: :hour)) %></p>
      </div>
      <%= button_to t("portail.subscriptions.credentials.reveal"), abonnement_identifiants_consultations_path(subscription.id),
            form: {data: {turbo: false}}, class: "fr-btn fr-btn--icon-left fr-icon-lock-unlock-line" %>
    <% else %>
      <%# Le bouton officiel ProConnect : l'agent voit qu'il part s'y identifier. Ce qu'il va vivre
          (la déconnexion) est lié au bouton. %>
      <p id="subscription-credentials-reauthentication" class="fr-mb-2w"><%= t("portail.subscriptions.credentials.reauthentication") %></p>
      <%= button_to abonnement_identifiants_consultations_path(subscription.id), class: "proconnect-button",
            form: {data: {turbo: false}}, aria: {describedby: "subscription-credentials-reauthentication"} do %>
        <span class="proconnect-sr-only"><%= t("portail.sessions.proconnect_button.label") %></span>
      <% end %>
    <% end %>
    <p class="fr-text--sm fr-text-mention--grey fr-mt-2w fr-mb-0"><%= t("portail.subscriptions.credentials.audited") %></p>
  </section>
<% end %>
