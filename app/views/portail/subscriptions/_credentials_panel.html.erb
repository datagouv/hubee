<%# locals: (subscription_id:, unlocked:) -%>
<%# La consultation est très sensible : sans réauthentification récente pour cet abonnement, le bloc
    propose d'abord de la faire. Le formulaire part hors Turbo, la réponse quitte le domaine vers
    ProConnect. L'id est la cible des turbo_stream qui remplacent le bloc. %>
<div id="subscription-credentials" class="fr-mb-4w">
  <section class="subscription-panel fr-p-3w fr-border-default--grey">
    <h2 class="fr-h6 fr-mb-2w">
      <span class="fr-icon-lock-line fr-mr-1w" aria-hidden="true"></span><%= t("portail.subscriptions.credentials.heading") %>
    </h2>
    <p class="fr-mb-2w"><%= t("portail.subscriptions.credentials.lead") %></p>
    <% if unlocked %>
      <p class="fr-mb-2w"><%= t("portail.subscriptions.credentials.verified") %></p>
      <%= button_to t("portail.subscriptions.credentials.reveal"), abonnement_identifiants_consultations_path(subscription_id),
            class: "fr-btn fr-btn--secondary" %>
    <% else %>
      <p class="fr-mb-2w"><%= t("portail.subscriptions.credentials.verify_lead") %></p>
      <%= button_to t("portail.subscriptions.credentials.verify"), reauthentication_path,
            params: {purpose: Portail::Access::Reauthentication.purpose(:credentials, subscription_id),
                     return_to: abonnement_path(subscription_id)},
            form: {data: {turbo: false}}, class: "fr-btn fr-btn--secondary" %>
    <% end %>
    <p class="fr-text--sm fr-text-mention--grey fr-mt-2w fr-mb-0"><%= t("portail.subscriptions.credentials.audited") %></p>
  </section>
</div>
