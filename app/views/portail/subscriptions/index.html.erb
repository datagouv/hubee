<% content_for :title, t(".title") %>

<h1><%= t(".heading") %></h1>
<p class="fr-text--lead"><%= t(".lead") %></p>

<% if @failure %>
  <p class="fr-text--lead"><%= t(".failures.#{@failure}") %></p>
<% elsif @subscriptions.empty? %>
  <p class="fr-text--lead"><%= t(".empty") %></p>
<% else %>
  <%# Emboîtement DSFR qui porte le défilement horizontal. Pas de pagination : une organisation
      a au plus un abonnement par flux, 51 flux en septembre 2026. À revoir si le catalogue grossit. %>
  <div class="fr-table fr-table--bordered">
    <div class="fr-table__wrapper">
      <div class="fr-table__container">
        <div class="fr-table__content">
          <table>
            <caption><%= t(".caption") %></caption>
            <thead>
              <tr>
                <th scope="col"><%= t(".fields.data_stream") %></th>
                <th scope="col"><%= t(".fields.access_mode") %></th>
                <th scope="col"><%= t(".fields.activity") %></th>
              </tr>
            </thead>
            <tbody>
              <% @subscriptions.each do |subscription| %>
                <tr>
                  <td><%= data_stream_label(subscription.data_stream_code, subscription.data_stream_name) %></td>
                  <td><%= subscription_access_mode(subscription) %></td>
                  <td><%= subscription_activity(subscription) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
<% end %>
