<% content_for :title, t("portail.sessions.failure.title") %>

<div class="fr-grid-row fr-grid-row--center">
  <div class="fr-col-12 fr-col-md-8">
    <h1><%= t("portail.sessions.failure.heading") %></h1>
    <p class="fr-text--lead"><%= t("portail.sessions.failure.body") %></p>

    <%# Une panne du fournisseur laisse l'agent sans recours : réessayer ne changera rien
        et rien d'autre ne lui est proposé. Le support est sa seule issue. %>
    <p>
      <%= t("portail.sessions.failure.support_html", email: mail_to(support_email)) %>
    </p>

    <%= render "portail/sessions/proconnect_button" %>
  </div>
</div>
