<%# L'adresse reste en clair : sur un poste sans client mail, les liens n'ouvrent rien. %>
<div class="fr-notice fr-notice--info">
  <div class="fr-container">
    <div class="fr-notice__body">
      <p>
        <span class="fr-notice__title"><%= t(".title") %></span>
        <%# Sous 576 px, le DSFR passe déjà le titre à la ligne : ce saut y ferait une ligne vide. %>
        <br class="fr-hidden fr-unhidden-sm">
        <span class="fr-notice__desc">
          <%= t(".support.line_html", link: beta_mail_to(:support, membership: current_membership, page_url: request.original_url)) %>
          <%= t(".feedback.line_html", link: beta_mail_to(:feedback, membership: current_membership, page_url: request.original_url),
                email: Portail::BetaNoticeHelper::BETA_EMAIL) %>
        </span>
      </p>
    </div>
  </div>
</div>
