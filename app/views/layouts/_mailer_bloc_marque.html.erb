<%# Le PNG clair a un fond blanc : un client qui inverse lui-même les couleurs garde l'image telle quelle. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td valign="middle" width="92">
      <%= image_tag attachments["marianne-clair.png"].url, alt: "République française", width: 92, class: "hide-black", style: "display: block; width: 92px; height: auto; border: 0;" %>
      <!--[if !mso]><!-->
      <%= image_tag attachments["marianne-sombre.png"].url, alt: "République française", width: 92, class: "hide-white", style: "display: none; width: 92px; height: auto; border: 0;" %>
      <!--<![endif]-->
    </td>
    <td valign="middle" align="right">
      <p class="darkmode" align="right" style="margin: 0; font-family: Marianne, Arial, Helvetica, sans-serif; font-size: 12px; line-height: 20px; color: #161616;"><strong>HubEE</strong><br><strong>Hub d'Échange de l'État</strong></p>
    </td>
  </tr>
</table>
