<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="supported-color-schemes" content="light dark">
    <%# Gabarit de courriel du SIG (GouvernementFR/dsfr-mail) : seul le mode sombre ne peut pas s'écrire en ligne. %>
    <style type="text/css">
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      .hide-white { display: none !important; }
      @media (prefers-color-scheme: dark) {
        body, .darkmode { background-color: #161616 !important; color: #ffffff !important; border-color: #2a2a2a !important; }
        .darkmode-1 { background-color: #161616 !important; color: #cecece !important; }
        .hide-black { display: none !important; }
        .hide-white { display: block !important; }
        a[href] { color: #8585f6 !important; }
        .darkmode-button-primary { background-color: #8585f6 !important; border-color: #8585f6 !important; }
        a.darkmode-button-color-primary[href] { color: #000091 !important; }
      }
    </style>
  </head>

  <body class="darkmode" style="margin: 0; padding: 0; background-color: #ffffff;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" class="darkmode" style="width: 100%;">
      <tr>
        <td align="center" style="padding: 24px 0;">
          <table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0" bgcolor="#ffffff" class="darkmode" style="width: 100%; max-width: 600px; border: 1px solid #e5e5e5;">
            <tr>
              <td class="darkmode" style="padding: 16px 52px 16px 44px; border-bottom: 1px solid #e5e5e5;">
                <%= render "layouts/mailer_bloc_marque" %>
              </td>
            </tr>
            <tr>
              <td class="darkmode-1" style="padding: 32px 52px; font-family: Marianne, Arial, Helvetica, sans-serif; font-size: 14px; line-height: 21px; color: #3a3a3a;">
                <%= yield %>
              </td>
            </tr>
            <tr>
              <td class="darkmode" style="padding: 24px 52px 24px 44px; border-top: 1px solid #e5e5e5;">
                <p class="darkmode-1" style="margin: 0 0 16px; padding-left: 8px; font-family: Marianne, Arial, Helvetica, sans-serif; font-size: 14px; line-height: 24px; color: #6b6b6b;">Ce message vous a été envoyé automatiquement. Merci de ne pas y répondre.</p>
                <%= render "layouts/mailer_bloc_marque" %>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
