<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
  </head>

  <body style="margin: 0; padding: 0; background-color: #f6f6f6; font-family: Arial, Helvetica, sans-serif; color: #161616;">
    <div style="max-width: 600px; margin: 0 auto; background-color: #ffffff;">
      <div style="padding: 16px 24px; border-bottom: 4px solid #000091; font-size: 18px; font-weight: bold; color: #000091;">HubEE - Hub d'Échange de l'État</div>

      <div style="padding: 24px; font-size: 16px; line-height: 1.5;">
        <%= yield %>
      </div>

      <div style="padding: 16px 24px; border-top: 1px solid #dddddd; font-size: 14px; color: #666666;">
        <p style="margin: 0;">Ce message vous a été envoyé automatiquement.</p>
        <p style="margin: 0;">Merci de ne pas y répondre.</p>
      </div>
    </div>
  </body>
</html>
