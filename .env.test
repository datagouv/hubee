# Valeurs factices de la suite de tests — fichier versionné (exception dans .gitignore).
#
# Chargé par dotenv avant config/environments/test.rb, et prioritaire sur `.env` :
# c'est ce qui garantit que les specs tournent à l'identique sur toutes les machines
# et en CI, quel que soit le `.env` local du développeur. Les cinq clés sont donc
# toutes définies ici, y compris celles dont les specs n'ont pas besoin — une clé
# absente retomberait sur le `.env` local et rouvrirait la porte.
#
# Ce sont des leurres : jamais d'identifiants ProConnect réels dans ce fichier.
# Aucun appel ne sort réellement — WebMock intercepte (cf. spec/rails_helper.rb).

PROCONNECT_CLIENT_ID=test-client-id
PROCONNECT_CLIENT_SECRET=test-client-secret
PROCONNECT_DOMAIN=https://proconnect.test
PROCONNECT_REDIRECT_URI=http://www.example.com/auth/proconnect/callback
PROCONNECT_POST_LOGOUT_REDIRECT_URI=http://www.example.com/
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=cle-de-test-non-secrete-depot-public
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=sel-de-test-non-secret-depot-public
SENSITIVE_PROCESS_CODES=DEMO_SENSIBLE
