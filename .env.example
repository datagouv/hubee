# Copier en .env et renseigner. Ce gabarit est versionné : jamais de valeur réelle ici.

# Schéma + préfixe /api/v2, sans slash final. Ex. : https://\<hôte-proconnect\>/api/v2
PROCONNECT_DOMAIN=

PROCONNECT_CLIENT_ID=
PROCONNECT_CLIENT_SECRET=

# À déclarer à l'identique dans l'espace partenaire ProConnect.
PROCONNECT_REDIRECT_URI=
PROCONNECT_POST_LOGOUT_REDIRECT_URI=

ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Codes des processus dont l'accès exige un second facteur, séparés par des virgules.
# Les vraies valeurs viennent d'ansible_deploy — jamais dans ce dépôt, qui est public.
# Déclarée mais vide = aucun processus sensible, et c'est un choix assumé ; absente,
# l'application refuse de démarrer.
SENSITIVE_PROCESS_CODES=

# Client de l'API V1, consommée via la gem privée. Les vraies valeurs viennent de l'outillage
# de déploiement interne, ou du socle de développement en local — jamais dans ce dépôt, qui est
# public. Aucune n'a de défaut : absente, la consultation des démarches lève une KeyError au
# premier appel, le reste du portail démarre normalement.
HUB_API_BASE_URL=
KEYCLOAK_BASE_URL=
KEYCLOAK_REALM=
HUB_API_CLIENT_ID=
HUB_API_CLIENT_SECRET=

# Deux scopes, et les deux sont nécessaires : l'API n'ouvre pas le référentiel et les
# téléservices aux mêmes, et un jeton n'en porte qu'un seul exploitable. Le client déclaré
# auprès de Keycloak doit donc les porter tous les deux — sinon le symptôme est un 500 opaque,
# pas un refus lisible. La gem les lit à la construction de son client et demande en interne le
# scope de la route appelée. HUB_API_SCOPE est le repli des deux autres et reste obligatoire.
HUB_API_SCOPE=
HUB_API_REFERENTIAL_SCOPE=
HUB_API_TELESERVICES_SCOPE=
